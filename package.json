{
  "name": "ai-coding-environment",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, provider-neutral AI coding operating environment and agent orchestrator",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/security/**/*.test.mjs\"",
    "test:workspaces": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx 2>/dev/null || echo \"lint: eslint not yet configured per-package\"",
    "typecheck": "tsc --noEmit -p tsconfig.base.json || true",
    "audit:deps": "npm audit --audit-level=high",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
